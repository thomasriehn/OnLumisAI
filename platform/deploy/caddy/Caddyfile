# OnLumis Reverse Proxy – einziger exponierter Dienst.
# ONLUMIS_DOMAIN=localhost  => interne CA (selbstsigniert)
# echte Domain              => ACME bzw. Zertifikat der Unternehmens-PKI

{$ONLUMIS_DOMAIN:localhost} {
	encode zstd gzip

	# Plattform-API (extern unter /api/*, intern /v1/*)
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Keycloak (laeuft mit --http-relative-path=/auth)
	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Grafana (nur mit --profile monitoring aktiv)
	handle_path /grafana/* {
		reverse_proxy grafana:3000
	}

	# Chat-UI & Admin-Portal
	handle {
		reverse_proxy webapp:3000
	}
}

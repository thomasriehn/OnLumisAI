# Aktivierung:
#   sudo cp onlumis-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now onlumis-backup.timer
[Unit]
Description=OnLumis Backup täglich 02:00

[Timer]
OnCalendar=*-*-* 02:00:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target

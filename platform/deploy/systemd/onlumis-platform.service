# Autostart des OnLumis-Stacks beim Boot der Spark.
# Installation:
#   sudo cp onlumis-platform.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now onlumis-platform
# Pfad ggf. anpassen (WorkingDirectory).
[Unit]
Description=OnLumis Plattform (Docker Compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/onlumis/platform
ExecStart=/usr/bin/docker compose --profile models up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

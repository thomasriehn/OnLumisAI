# OnLumis-Plattform – Konfiguration
# Kopieren nach .env und Werte setzen:  cp .env.example .env

# --- Pflicht: Zugangsdaten (starke Zufallswerte setzen!) ---------------------
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# --- Erreichbarkeit ----------------------------------------------------------
# Interner DNS-Name der Installation. "localhost" => Caddy nutzt selbst-
# signiertes Zertifikat (interne CA); echte Domain => ACME/Unternehmens-PKI.
ONLUMIS_DOMAIN=localhost

# --- Authentifizierung -------------------------------------------------------
# dev  = X-Dev-User/X-Dev-Groups-Header (NUR fuer Entwicklung/Tests!)
# oidc = Keycloak (Produktion)
AUTH_MODE=dev
OIDC_ISSUER_URL=https://localhost/auth/realms/onlumis

# --- Modell-Serving (DGX Spark, --profile models) ----------------------------
# NGC-vLLM-Image fuer DGX Spark (aarch64 + CUDA); Tag beim Setup fixieren.
VLLM_IMAGE=nvcr.io/nvidia/vllm:latest
CHAT_MODEL_ID=Qwen/Qwen3-32B-FP8
EMBED_MODEL_ID=BAAI/bge-m3
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
CHAT_GPU_MEM_FRACTION=0.55
EMBED_GPU_MEM_FRACTION=0.06
RERANK_GPU_MEM_FRACTION=0.06
CHAT_MAX_MODEL_LEN=16384
# Air-Gap: 1 setzen, Modelle vorab in das hf-cache-Volume laden (models/).
HF_HUB_OFFLINE=0

# --- Ingestion ----------------------------------------------------------------
# Host-Pfad mit den zu indexierenden Dokumenten (SMB/NFS-Mount auf der Spark).
SOURCES_PATH=./data/sources
SYNC_INTERVAL_SECONDS=900
# 1 = OCR-Fallback für gescannte PDFs ins Ingestion-Image einbauen
# (Tesseract deu+eng, Poppler; Image wird dadurch größer)
WITH_OCR=0

# --- Audit ---------------------------------------------------------------------
# false = Fragen nur als SHA-256-Hash im Audit-Log (Datenschutz-Default).
AUDIT_LOG_QUESTIONS=false

# --- Monitoring (--profile monitoring) ----------------------------------------
GRAFANA_ADMIN_PASSWORD=

# --- Nur Entwicklung (compose.dev.yml) -----------------------------------------
DEV_CHAT_BASE_URL=http://host.docker.internal:11434/v1
DEV_CHAT_MODEL=qwen3:4b
